[Unit]
Description=Z-CORE AI Security Gateway - IA22_LOGIC
After=network.target

[Service]
Type=simple
User=netsecure
WorkingDirectory=/opt/netsecurepro/IA22_LOGIC
ExecStart=/opt/netsecurepro/venv/bin/python src/z_core_gateway.py --port 8443
Restart=always
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/log/z-core /opt/netsecurepro/logs

[Install]
WantedBy=multi-user.target
